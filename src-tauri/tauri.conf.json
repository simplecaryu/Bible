{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible",
  "version": "0.1.0",
  "identifier": "com.cha.bible",
  "build": {
    "features": ["desktop"],
    "frontendDist": [
      "../index.html",
      "../styles.css",
      "../app.js",
      "../desktop-api.js"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bible",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "resources": {
      "resources/bible.db": "bible.db"
    },
    "icon": [
      "../icons/icon-192.png",
      "../icons/icon-512.png"
    ],
    "shortDescription": "Offline multi-translation Bible reader",
    "longDescription": "An offline desktop Bible reader for comparing translations side by side."
  }
}

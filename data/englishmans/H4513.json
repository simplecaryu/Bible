{"lemma":"מָנַע","translit":"mânaʻ","pronunciation":"maw-nah'","def":"to debar (negatively or positively) from benefit or injury","kjv":"deny, keep (back), refrain, restrain, withhold.","occ":[[29,4,7,"And also I have withholden"],[23,2,25,"Withhold"],[17,31,16,"If I have withheld"],[19,11,26,"He that withholdeth"],[19,23,13,"Withhold"],[19,3,27,"Withhold"],[23,3,3,"have been withholden"],[23,31,16,"Refrain"],[17,20,13,"it not; but keep it still"],[17,38,15,"is withholden"],[19,30,7,"of thee; deny"],[20,2,10,"not from them, I withheld"],[23,5,25,"have withholden"],[17,22,7,"and thou hast withholden"],[19,1,15,"with them; refrain"],[18,21,2,"and hast not withholden"],[15,9,20,"them, and withheldest"],[8,25,34,"which hath kept me back"],[8,25,26,"hath withholden"],[0,30,2,"stead, who hath withheld"],[23,48,10,"he that keepeth back"],[9,13,13,"for he will not withhold"],[3,22,16,"Let nothing, I pray thee, hinder"],[3,24,11,"hath kept thee back"],[25,31,15,"for him, and I restrained"],[18,84,11,"will he withhold"],[23,42,4,"unto you; I will keep"],[28,1,13,"is withholden"],[23,42,4,"back"],[10,20,7,"and I denied"]]}